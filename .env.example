# Copy this file to .env and fill in real values. Never commit .env.
# PostgreSQL connection string used by Prisma for the contact form.
DATABASE_URL="postgres://user:password@host:5432/dbname"

# --- Admin dashboard (/admin) ---
# The only Google account allowed to sign in. If this is empty, nobody can.
ADMIN_EMAIL="you@example.com"
# Random string used to sign sessions. Generate one with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
# Google OAuth credentials from Google Cloud Console (APIs & Services > Credentials).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
